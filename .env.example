POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
# 127.0.0.1 = this server only. 0.0.0.0 = open to the internet (TLS required, see README)
POSTGRES_BIND=127.0.0.1
# IP or domain that apps connect to; it goes into the TLS certificate so they can verify the server
POSTGRES_TLS_HOST=
POSTGRES_PORT=5432
DATABASUS_PORT=4005
